# OpenRouter / OpenAI Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM Model Configuration
# Default recommended model on OpenRouter: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, or meta-llama/llama-3.3-70b-instruct
LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding Model (SentenceTransformer local model name or HuggingFace ID)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage & Upload Limits (in Megabytes)
MAX_FILE_SIZE_MB=50
MAX_TOTAL_SIZE_MB=100
